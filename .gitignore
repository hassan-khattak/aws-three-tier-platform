# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# TypeScript v1 declaration files
typings/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# next.js build output
.next

# Local source checkout retained for provenance; not a submodule
/node-3tier-app2/

# Local environment values; commit only sanitized examples
.env.*
!.env.example

# Terraform local caches, state, generated plans, and local variable values
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.json
*.tfvars
*.tfvars.json
crash.log
crash.*.log
# Keep .terraform.lock.hcl and *.tfvars.example under version control.

# Local editor / OS artifacts
.DS_Store

# Real backend settings are account-specific; commit only the .example files
infra/**/backend.hcl

# Terraform override files are local, one-off changes
*_override.tf
