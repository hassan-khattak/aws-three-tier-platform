# Documentation only: the application does not automatically load this file.
# Export these values, or use your container's environment-file mechanism.
NODE_ENV=development
PORT=3000
DB=assessment
DBUSER=assessment_app
DBPASS=replace-with-a-local-only-password
DBHOST=localhost
DBPORT=5432
# Explicit opt-out is allowed only outside production for a disposable local DB.
DB_SSL=false
# Production requires DB_SSL=true and a readable trusted CA bundle.
# DB_CA_FILE=/app/certs/global-bundle.pem
